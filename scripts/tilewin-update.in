#!/bin/bash
# tilewin-update: brings this computer to the newest tileWin, in one of two ways.
#
#   tilewin-update                 asks which way
#   tilewin-update release         the newest release from GitHub: its ready-made
#                                  archive if it runs here, or else its source
#   tilewin-update source          the newest source: the repository is pulled
#                                  into a temporary folder and built there
#   tilewin-update check           says what is installed and the newest release
#
#   --force        also when the release is what is installed already
#   --no-restart   leave out "tilewinmsg restart" at the end
#
# The temporary folder is deleted afterwards, whatever happened. A running
# tileWin is restarted with "tilewinmsg restart" after a good update, which keeps
# the windows open. Without a terminal to ask a password in (the settings app),
# pkexec asks instead of sudo.
#
# Built with -Dself-update=false a package manager owns the files, and this only
# says what the newest release is.
set -euo pipefail

VERSION='@version@'
PREFIX=${TILEWIN_UPDATE_PREFIX:-'@prefix@'}
MANAGED='@managed@'
REPO=${TILEWIN_UPDATE_REPO:-KsmBl/tileWin}
API=${TILEWIN_UPDATE_API:-https://api.github.com/repos/$REPO/releases/latest}
GIT_URL=${TILEWIN_UPDATE_GIT:-https://github.com/$REPO.git}

force=0
restart=1
action=
for arg in "$@"; do
	case $arg in
	release|source|check) action=$arg ;;
	--force) force=1 ;;
	--no-restart) restart=0 ;;
	-h|--help) sed -n '2,/^set -euo/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'; exit 0 ;;
	*) echo "tilewin-update: unknown argument: $arg (try --help)" >&2; exit 2 ;;
	esac
done

say() { printf '==> %s\n' "$*"; }
die() { printf 'tilewin-update: %s\n' "$*" >&2; exit 1; }

needs() {
	command -v "$1" >/dev/null 2>&1 || die "$1 is not installed, and $2"
}

# the newest release: sets tag and archive and sums, the addresses of its files
read_release() {
	needs curl "it fetches the release from GitHub"
	local json
	json=$(curl -fsSL --retry 2 -H 'Accept: application/vnd.github+json' "$API") ||
		die "could not ask GitHub for the newest release"
	# one key to a line or all on one: GitHub's answer has been both
	json=$(printf '%s\n' "$json" | sed 's/,[[:space:]]*"/,\n"/g')
	tag=$(printf '%s\n' "$json" | sed -n 's/^[[:space:]]*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
	[ -n "$tag" ] || die "GitHub names no release"
	local urls
	urls=$(printf '%s\n' "$json" | sed -n 's/.*"browser_download_url":[[:space:]]*"\([^"]*\)".*/\1/p')
	archive=$(printf '%s\n' "$urls" | grep -- "-$(uname -m)-linux\.tar\.gz$" | head -n 1 || true)
	sums=$(printf '%s\n' "$urls" | grep '/SHA256SUMS$' | head -n 1 || true)
}

restart_tilewin() {
	if [ "$restart" -eq 0 ]; then
		return 0
	fi
	if command -v tilewinmsg >/dev/null 2>&1 && tilewinmsg -t get_version >/dev/null 2>&1; then
		say "Restarting tileWin; your windows stay open"
		tilewinmsg restart >/dev/null || die "tileWin is updated, but tilewinmsg restart failed"
	fi
}

root_command() {
	if [ "$(id -u)" -eq 0 ]; then
		echo ""
	elif [ -t 0 ]; then
		echo sudo
	else
		echo pkexec
	fi
}

work=
cleanup() {
	if [ -n "$work" ]; then
		rm -rf "$work"
	fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# the source of a tag, or of the newest commit without one, built and installed
from_source() {
	local ref=${1:-}
	needs git "it pulls the source"
	work=$(mktemp -d "${TMPDIR:-/tmp}/tilewin-update.XXXXXX")
	say "Pulling ${ref:-the newest source} into $work"
	git clone --quiet --depth 1 ${ref:+--branch "$ref"} "$GIT_URL" "$work/tileWin" ||
		die "could not pull the repository"
	cd "$work/tileWin"
	say "Building; this takes a few minutes"
	TILEWIN_SUDO=$(root_command) TILEWIN_BUILD_DIR=build-release ./install.sh --no-deps \
		--prefix "$PREFIX" || die "the build failed. If a library is missing, its name is above;
\"./install.sh\" in a clone of the repository installs what it needs"
	cd /
}

# the ready-made archive; false when it cannot be used here, and it says why
from_archive() {
	if [ -z "$archive" ]; then
		say "This release has no archive for $(uname -m)"
		return 1
	fi
	if [ "$PREFIX" != /usr/local ]; then
		say "The archive is made for /usr/local and this is installed in $PREFIX"
		return 1
	fi
	work=$(mktemp -d "${TMPDIR:-/tmp}/tilewin-update.XXXXXX")
	local name=${archive##*/}
	say "Downloading $name"
	curl -fsSL --retry 2 -o "$work/$name" "$archive" || die "could not download $archive"
	if [ -n "$sums" ]; then
		curl -fsSL --retry 2 -o "$work/SHA256SUMS" "$sums" || die "could not download $sums"
		(cd "$work" && sha256sum --check --ignore-missing --status SHA256SUMS) ||
			die "$name does not match its checksum; nothing was installed"
	else
		die "this release has no SHA256SUMS to check $name against; nothing was installed"
	fi
	mkdir "$work/unpacked"
	tar -xzf "$work/$name" -C "$work/unpacked"
	local top=$work/unpacked/tilewin
	[ -x "$top/stage$PREFIX/bin/tilewin" ] || die "$name is not a tileWin archive"
	local missing
	missing=$(ldd "$top/stage$PREFIX/bin/tilewin" 2>/dev/null | grep 'not found' || true)
	if [ -n "$missing" ]; then
		say "The archive does not run on this system: $(printf '%s' "$missing" | awk '{print $1}' | tr '\n' ' ')"
		rm -rf "$work"
		work=
		return 1
	fi
	say "Installing"
	local root
	root=$(root_command)
	$root sh "$top/tilewin-system-setup" "$PREFIX" "$top" "$(id -u):$(id -g)" stage "$top/stage" \
		${TILEWIN_UPDATE_ROOT:+"$TILEWIN_UPDATE_ROOT"} ||
		die "could not install; if the password was refused, nothing changed"
}

if [ -n "$MANAGED" ] && [ "$action" != check ]; then
	die "tileWin $VERSION was installed by your package manager: update it there"
fi

if [ -z "$action" ]; then
	[ -t 0 ] || die "say which way: tilewin-update release or tilewin-update source"
	echo "tileWin $VERSION is installed. How do you want to update?"
	echo "  1) the newest release (ready-made when it runs on this system)"
	echo "  2) build the newest source (the repository goes into a temporary folder)"
	read -r -p "1 or 2: " choice
	case $choice in
	1) action=release ;;
	2) action=source ;;
	*) die "nothing done" ;;
	esac
fi

case $action in
check)
	echo "installed $VERSION"
	[ -z "$MANAGED" ] || echo "managed yes"
	read_release
	echo "release ${tag#v}"
	echo "archive ${archive:+yes}"
	;;
release)
	read_release
	if [ "${tag#v}" = "$VERSION" ] && [ "$force" -eq 0 ]; then
		say "tileWin $VERSION is the newest release already"
		exit 0
	fi
	say "tileWin $VERSION is installed; the newest release is ${tag#v}"
	if ! from_archive; then
		say "Building that release from its source instead"
		from_source "$tag"
	fi
	restart_tilewin
	say "tileWin ${tag#v} is installed"
	;;
source)
	from_source
	restart_tilewin
	say "tileWin is built from the newest source and installed"
	;;
esac
