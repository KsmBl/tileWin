#!/bin/sh
# tilewin-session: starts a tileWin session (used by display managers and
# from a TTY). When tileWin exits with code 42 ("restart" command) it is
# started again, so updates can be applied without logging out.

TILEWIN_BIN="${TILEWIN_BIN:-@bindir@/tilewin}"
[ -x "$TILEWIN_BIN" ] || TILEWIN_BIN=tilewin

# Start a D-Bus session bus if the display manager did not provide one.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -z "$TILEWIN_SESSION_DBUS" ] &&
		command -v dbus-run-session >/dev/null 2>&1; then
	export TILEWIN_SESSION_DBUS=1
	exec dbus-run-session -- "$0" "$@"
fi

# The variables of environment.d (~/.config/environment.d, /etc/environment.d),
# as GNOME and Plasma sessions have them: e.g. GTK3_MODULES, which gives GTK 3
# apps failBrauwser's open and save dialogs (tileWin turns them on only while
# failBrauwser is the default file manager). One VAR=value a line, exported
# as it is, never evaluated.
envgen=/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator
[ -x "$envgen" ] || envgen=/lib/systemd/user-environment-generators/30-systemd-environment-d-generator
if [ -x "$envgen" ]; then
	while IFS= read -r line; do
		case "$line" in
		[A-Za-z_]*=*) export "$line" ;;
		esac
	done <<EOF
$("$envgen" 2>/dev/null)
EOF
fi

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-tileWin}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-tileWin}"
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
# Qt knows no desktop called tileWin and would fall back to a theme that never
# asks whether the session is dark; the portal's tells it (and follows a switch
# while the app runs). A theme of the user's own, such as qt6ct, stays.
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-xdgdesktopportal}"
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-wayland}"
export _JAVA_AWT_WM_NONREPARENTING=1
export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/tileWin"
mkdir -p "$state_dir"
log="$state_dir/tilewin.log"

restarts=0
while :; do
	# keep the previous log for debugging crashes
	[ -f "$log" ] && mv -f "$log" "$log.old"
	"$TILEWIN_BIN" "$@" 2>"$log"
	rc=$?
	if [ "$rc" -ne 42 ]; then
		exit "$rc"
	fi
	restarts=$((restarts + 1))
	if [ "$restarts" -gt 50 ]; then
		echo "tilewin-session: too many restarts, giving up" >&2
		exit 1
	fi
done
