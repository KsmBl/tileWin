executable(
	'tilewin-settings', [
		'backup.c',
		'confdoc.c',
		'ipc.c',
		'main.c',
		'page_about.c',
		'page_account.c',
		'page_animations.c',
		'page_apps.c',
		'page_appwindows.c',
		'page_backup.c',
		'page_bluetooth.c',
		'page_datetime.c',
		'page_desktop.c',
		'page_dns.c',
		'page_keyboard.c',
		'page_launcher.c',
		'page_menus.c',
		'page_mouse.c',
		'page_network.c',
		'page_screen.c',
		'page_screensaver.c',
		'page_sound.c',
		'page_taskbar.c',
		'page_theme.c',
		'page_wallpaper.c',
		'page_window.c',
		'presets.c',
		'reorder.c',
		'snaplayouts.c',
		'ui.c',
		'widgets.c',
		tilewin_version_h,
	],
	include_directories: [sway_inc, saver_inc],
	dependencies: [gtk4, dependency('gio-unix-2.0'), jsonc, cairo, gdk_pixbuf, math, rsvg, pango,
		pangocairo],
	# the kit whole, its functions lent to the savers the preview loads
	link_whole: [lib_saver_kit],
	link_with: [lib_sway_common],
	c_args: ['-DTILEWIN_LIBEXECDIR="@0@"'.format(join_paths(prefix, get_option('libexecdir')))],
	export_dynamic: true,
	install: true,
)

install_data(
	'../data/tilewin-settings.desktop',
	install_dir: join_paths(datadir, 'applications'),
)
