#!/bin/bash
# Puts the kernels tilewin-kernel built onto the computer, for the Kernel page
# of the tileWin settings, which runs it with pkexec. It is the only part that
# runs as root:
#
#   tilewin-kernel-root info               how this computer boots, key=value
#   tilewin-kernel-root install KVER STORE puts the kernel built in STORE/KVER on
#                                          the computer and into the boot menu
#   tilewin-kernel-root remove KVER        takes it off again
#   tilewin-kernel-root load KVER [STORE]  starts it now with kexec: the programs
#                                          end, the firmware and the boot menu
#                                          are skipped
#   tilewin-kernel-root boot KVER [STORE]  restarts the computer into it, once
#                                          (with STORE, a kernel not on the
#                                          computer yet is put on first)
#   tilewin-kernel-root tools PACKAGE...   installs the programs a build needs
#   tilewin-kernel-root livepatch-apply KVER NAME STORE
#                                          loads the livepatch module NAME built
#                                          for the running kernel KVER: the fix
#                                          takes hold without a restart
#   tilewin-kernel-root livepatch-undo NAME
#                                          takes it back out again
#   tilewin-kernel-root livepatch-start KVER NAME STORE on|off
#                                          applies it at every start of KVER (a
#                                          kernel on the computer, running or
#                                          not), or no more
#   tilewin-kernel-root livepatch-boot     applies those of the running kernel;
#                                          tilewin-kernel-livepatch.service runs it
#   tilewin-kernel-root auto-enable USER PROFILE NATIVE SERIES [KEY=VALUE...]
#                                          switches the automatic updates on
#                                          (see "the automatic updates" below):
#                                          what goes in, for this processor
#                                          only on|off, and a new series at the
#                                          end of the old one or as soon as it
#                                          is out (end|new)
#   tilewin-kernel-root auto-disable       switches them off again
#   tilewin-kernel-root auto-config KEY=VALUE...
#                                          several options at once, the schedule
#                                          (when, time, catchup) too
#   tilewin-kernel-root auto-set KEY VALUE battery yes|no, series end|new,
#                                          native on|off, profile
#   tilewin-kernel-root auto-schedule WHEN HH:MM CATCHUP
#                                          when they run: daily or mon..sun, the
#                                          time, and yes to make up at the next
#                                          start for a time the computer was off
#   tilewin-kernel-root auto-run           what tilewin-kernel-auto.service does
#                                          at the time set (and -now.service at
#                                          "Update now")
#   tilewin-kernel-root auto-boot          what tilewin-kernel-auto-boot.service
#                                          does at every start
#   tilewin-kernel-root scheduler-default SCHEDULER MODE
#                                          the sched_ext scheduler scx_loader
#                                          starts with the computer, or "none"
#
# What it never touches, so that the computer boots as before whatever goes
# wrong: the kernel of the distribution and its boot image, the boot loader
# and its settings (grub.cfg, grubenv, /etc/default/grub, loader.conf) and the
# boot order of the firmware.
#
#  - Where the boot loader finds unified kernel images (UKIs) by itself, the
#    kernel becomes one: EFI/Linux/tilewin-KVER.efi on the EFI system
#    partition. systemd-boot lists those, GRUB does with its "uki" command
#    (grub.d/15_uki), and the firmware can start one directly. Booting into it
#    once is systemd-boot's one-shot entry, or else the firmware's BootNext
#    pointing at a boot entry of its own (made without adding it to the boot
#    order): the next start after that is the usual one again.
#  - With a GRUB that knows no UKIs (or no UEFI at all), vmlinuz-KVER and
#    initramfs-KVER.img go to /boot and grub.cfg is made anew by grub-mkconfig,
#    only replacing the old one when grub-script-check finds no fault in it;
#    the old one stays beside it as grub.cfg.tilewin-backup. Booting once is
#    grub-reboot, which needs GRUB_DEFAULT=saved.
#
# The modules go to /usr/lib/modules/KVER, which a .tilewin-kernel file marks
# as ours: nothing without that file is ever removed, nor installed over. KVER
# is VERSION-NAME, VERSION-tilewinN unless the user named it.
#
# For the tests: TILEWIN_KERNEL_ROOT puts every file below a directory of its
# own, TILEWIN_KERNEL_ESP names the EFI system partition, TILEWIN_KERNEL_RUNNING
# the running kernel (pkexec passes no such variable on).
set -uo pipefail
export PATH=${TILEWIN_KERNEL_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin}
umask 022

root=${TILEWIN_KERNEL_ROOT:-}
modules=$root/usr/lib/modules
efivars=$root/sys/firmware/efi/efivars
running=${TILEWIN_KERNEL_RUNNING:-$(uname -r)}
loader_guid=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
marker=.tilewin-kernel
# the packages a build may ask for (Arch names)
allowed_tools=" make gcc binutils bc flex bison perl openssl cpio xz zstd lz4 gzip lzop curl python tar pahole libelf kexec-tools base-devel rust rust-bindgen rust-src ccache patchutils scx-scheds scx-tools "
livepatch_sys=$root/sys/kernel/livepatch
scx_conf=$root/etc/scx_loader/config.toml

die() { echo "$*" >&2; exit 1; }
note() { echo "$*"; }

# What may be put on the computer: what root or the user who asked owns, and,
# for the automatic updates (auto_uid set), what their system user built in
# their own store, which only it and root can write to.
auto_uid=
owned() { # file
	local owner
	owner=$(stat -c %u "$1") || return 1
	[[ $owner == 0 || $owner == "${PKEXEC_UID:-0}" ]] && return 0
	[[ -n $auto_uid && $owner == "$auto_uid" ]] || return 1
	local real store
	real=$(realpath -e "$1") && store=$(realpath -e "$(auto_get store)") || return 1
	[[ $real == "$store"/* ]]
}

# VERSION-NAME, the name what tilewin-kernel takes; which kernels are ours
# the marker says
valid_kver() {
	[[ $1 =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?-(.+)$ ]] &&
		[[ ${BASH_REMATCH[2]} =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,31}$ ]]
}

# ---------- how this computer boots ----------

efi() { [[ -d $root/sys/firmware/efi ]]; }

esp() {
	if [[ -n ${TILEWIN_KERNEL_ESP:-} ]]; then
		echo "$TILEWIN_KERNEL_ESP"
		return
	fi
	local p
	p=$(bootctl --print-esp-path 2>/dev/null) && [[ -d $p ]] && { echo "$p"; return; }
	for p in /efi /boot /boot/efi; do
		[[ $(findmnt -n -o FSTYPE --mountpoint "$p" 2>/dev/null) == vfat ]] && { echo "$p"; return; }
	done
	return 1
}

# What the boot loader says it is, through the Boot Loader Interface.
loader() {
	local f=$efivars/LoaderInfo-$loader_guid
	[[ -r $f ]] || return 0
	tail -c +5 "$f" | iconv -f UTF-16LE -t UTF-8 2>/dev/null | tr -d '\0'
}

grub_cfg() {
	local p e
	e=$(esp 2>/dev/null)
	for p in "$root/boot/grub/grub.cfg" "$root/boot/grub2/grub.cfg" ${e:+"$e/grub/grub.cfg"}; do
		[[ -f $p ]] && { echo "$p"; return; }
	done
	return 1
}

# uki: an image on the EFI partition; grub: vmlinuz and initramfs in /boot and
# grub-mkconfig; how a kernel is booted once: oneshot (systemd-boot), bootnext
# (the firmware) or grub-reboot.
method() {
	local name cfg
	name=$(loader)
	if efi && [[ $name == systemd-boot* ]]; then
		echo "uki oneshot"
		return
	fi
	cfg=$(grub_cfg 2>/dev/null)
	if efi && [[ -n $cfg ]] && grep -Eq '^[[:space:]]*uki([[:space:]]|$)' "$cfg"; then
		echo "uki bootnext"
	elif [[ -n $cfg ]]; then
		echo "grub grub-reboot"
	elif efi && esp >/dev/null; then
		# a boot loader of its own kind: the firmware starts the image
		echo "uki bootnext"
	else
		echo "none none"
	fi
}

# mkinitcpio (Arch), dracut (Fedora, and Debian when chosen) or initramfs-tools
# (Debian and Ubuntu)
initramfs_tool() {
	if command -v mkinitcpio >/dev/null 2>&1; then
		echo mkinitcpio
	elif command -v dracut >/dev/null 2>&1; then
		echo dracut
	elif command -v mkinitramfs >/dev/null 2>&1; then
		echo mkinitramfs
	fi
}
no_initramfs_tool="None of mkinitcpio, dracut and initramfs-tools is installed"

# The command line the kernel of the distribution gets, as mkinitcpio finds it.
cmdline() {
	if [[ -s $root/etc/kernel/cmdline ]]; then
		tr -s '\n' ' ' < "$root/etc/kernel/cmdline"
	elif [[ -d $root/etc/cmdline.d ]] && ls "$root"/etc/cmdline.d/*.conf >/dev/null 2>&1; then
		cat "$root"/etc/cmdline.d/*.conf | grep -v '^#' | tr -s '\n' ' '
	else
		tr ' ' '\n' < "$root/proc/cmdline" | grep -Ev '^(BOOT_IMAGE|initrd)=' | tr '\n' ' '
	fi | sed 's/ *$//'
}

# Secure Boot on: the firmware starts only signed images, and these are not.
secure_boot() {
	local f=$efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
	[[ -r $f ]] && [[ $(od -An -tu1 -j4 -N1 "$f" 2>/dev/null | tr -d ' ') == 1 ]]
}

kexec_ready() {
	command -v kexec >/dev/null 2>&1 || { echo "no: install kexec-tools"; return; }
	[[ $(cat "$root/proc/sys/kernel/kexec_load_disabled" 2>/dev/null) == 1 ]] &&
		{ echo "no: kexec is switched off (kernel.kexec_load_disabled)"; return; }
	echo yes
}

info() {
	local m e free=""
	read -r m _ <<<"$(method)"
	e=$(esp 2>/dev/null)
	[[ -n $e ]] && free=$(df -Pk "$e" | awk 'NR == 2 { print $4 }')
	echo "loader=$(loader)"
	echo "efi=$(efi && echo yes || echo no)"
	echo "method=$(method | tr ' ' ',')"
	echo "esp=$e"
	echo "esp_free_kb=$free"
	echo "initramfs=$(initramfs_tool)"
	echo "kexec=$(kexec_ready)"
	echo "livepatch=$([[ -d $root/sys/kernel/livepatch ]] && echo yes || echo no)"
	echo "secureboot=$(secure_boot && echo on || echo off)"
	echo "sched_ext=$(cat "$root/sys/kernel/sched_ext/state" 2>/dev/null || echo none)"
	echo "scx=$(command -v scx_loader >/dev/null 2>&1 && echo yes || echo no)"
	echo "running=$running"
}

# ---------- putting a kernel on ----------

lock() {
	mkdir -p "$root/run"
	exec 9> "$root/run/tilewin-kernel.lock"
	flock -n 9 || die "Another kernel is being put on or taken off"
}

ours() { [[ -f $modules/$1/$marker ]]; }

marker_get() { # kver key
	sed -n "s/^$2=//p" "$modules/$1/$marker" | head -n 1
}

os_release() { # kver out
	local name
	name=$(. "$root/etc/os-release" 2>/dev/null; echo "${NAME:-Linux}")
	{
		grep -Ev '^(PRETTY_NAME|IMAGE_ID|IMAGE_VERSION)=' "$root/etc/os-release" 2>/dev/null
		echo "PRETTY_NAME=\"$name (tileWin kernel $1)\""
		echo "IMAGE_ID=tilewin-kernel"
		echo "IMAGE_VERSION=$1"
	} > "$2"
}

# Makes the initramfs (and the UKI), in work.
make_images() { # kver work compression uki
	local kver=$1 work=$2 comp=$3 uki=$4 tool z
	tool=$(initramfs_tool)
	case $comp in lzo) z=lzop ;; *) z=$comp ;; esac
	case $tool in
	mkinitcpio)
		mkinitcpio -k "$kver" -g "$work/initramfs.img" -z "$z" >&2 ||
			die "mkinitcpio could not make the initramfs"
		if [[ $uki == yes ]]; then
			os_release "$kver" "$work/os-release"
			mkinitcpio -k "$kver" -U "$work/kernel.efi" -z "$z" \
				--osrelease "$work/os-release" >&2 || die "mkinitcpio could not make the boot image"
		fi
		;;
	dracut)
		dracut --force --kver "$kver" --compress "$z" "$work/initramfs.img" >&2 ||
			die "dracut could not make the initramfs"
		if [[ $uki == yes ]]; then
			dracut --force --uefi --kver "$kver" --compress "$z" \
				--kernel-cmdline "$(cmdline)" "$work/kernel.efi" >&2 ||
				die "dracut could not make the boot image"
		fi
		;;
	mkinitramfs)
		mkinitramfs -c "$z" -o "$work/initramfs.img" "$kver" >&2 ||
			die "mkinitramfs could not make the initramfs"
		# initramfs-tools makes no UKI by itself: ukify puts the kernel, the
		# initramfs and the command line together
		if [[ $uki == yes ]]; then
			command -v ukify >/dev/null 2>&1 ||
				die "A unified kernel image needs ukify: install systemd-ukify and systemd-boot-efi"
			os_release "$kver" "$work/os-release"
			ukify build --linux="$modules/$kver/vmlinuz" --initrd="$work/initramfs.img" \
				--cmdline="$(cmdline)" --os-release="@$work/os-release" --uname="$kver" \
				--output="$work/kernel.efi" >&2 || die "ukify could not make the boot image"
		fi
		;;
	*) die "$no_initramfs_tool" ;;
	esac
}

fits() { # file dir
	local need free
	need=$(( $(stat -c %s "$1") / 1024 + 16384 )) # and 16 MB to spare
	free=$(df -Pk "$2" | awk 'NR == 2 { print $4 }')
	[[ $free -ge $need ]] || die "There is not enough room on $2: $((need / 1024)) MB are needed, $((free / 1024)) MB are free. Take another kernel off first."
}

# grub.cfg anew, only when the new one is sound; the old one is kept beside it.
grub_update() {
	local cfg
	cfg=$(grub_cfg) || die "There is no grub.cfg"
	grub-mkconfig -o "$cfg.tilewin-new" >&2 || { rm -f "$cfg.tilewin-new"; die "grub-mkconfig failed: grub.cfg is as it was"; }
	if command -v grub-script-check >/dev/null 2>&1 && ! grub-script-check "$cfg.tilewin-new" >&2; then
		rm -f "$cfg.tilewin-new"
		die "The new grub.cfg has faults: grub.cfg is as it was"
	fi
	cp -p "$cfg" "$cfg.tilewin-backup"
	mv "$cfg.tilewin-new" "$cfg"
	sync
}

install_kernel() { # kver store
	local kver=$1 store=$2 src
	valid_kver "$kver" || die "not a kernel of tileWin: $kver"
	src=$store/$kver
	[[ -d $src && -f $src/info && -f $src/vmlinuz && -d $src/modules/lib/modules/$kver ]] ||
		die "$kver is not built"
	[[ $(cat "$src/state" 2>/dev/null) == built ]] || die "$kver is not built"
	# the store of the user who asked, or root's
	local owner
	owned "$src" || die "$src belongs to someone else"
	if [[ -e $modules/$kver ]]; then
		ours "$kver" || die "$modules/$kver is there already and not ours"
		die "$kver is on the computer already"
	fi
	local m how
	read -r m how <<<"$(method)"
	[[ $m != none ]] || die "No boot loader was found that tileWin can add a kernel to"
	[[ -n $(initramfs_tool) ]] || die "$no_initramfs_tool"
	local comp
	comp=$(sed -n 's/^compression=//p' "$src/info")
	lock

	local work
	work=$(mktemp -d "$root/var/tmp/tilewin-kernel.XXXXXX" 2>/dev/null || mktemp -d)
	placed=()
	cleanup() {
		local p
		for p in "${placed[@]}"; do
			rm -rf -- "$p"
		done
		rm -rf -- "$work"
	}
	trap 'cleanup' EXIT

	note "Copying the modules"
	mkdir -p "$modules"
	rm -rf -- "$modules/.$kver.new"
	cp -a "$src/modules/lib/modules/$kver" "$modules/.$kver.new" || die "could not copy the modules"
	placed+=("$modules/.$kver.new")
	cp "$src/vmlinuz" "$modules/.$kver.new/vmlinuz"
	[[ -d $src/headers ]] && cp -a "$src/headers" "$modules/.$kver.new/build"
	chown -R 0:0 "$modules/.$kver.new" 2>/dev/null
	mv "$modules/.$kver.new" "$modules/$kver"
	placed=("$modules/$kver")
	{
		echo "method=$m"
		echo "boot=$how"
		echo "installed=$(date +%s)"
	} > "$modules/$kver/$marker"
	depmod ${root:+-b "$root"} "$kver" >&2 || die "depmod failed"
	if command -v dkms >/dev/null 2>&1 && [[ -d $modules/$kver/build ]]; then
		note "Building the DKMS modules"
		dkms autoinstall -k "$kver" >&2 || note "Some DKMS modules could not be built for $kver"
	fi

	note "Making the boot image"
	make_images "$kver" "$work" "${comp:-zstd}" "$([[ $m == uki ]] && echo yes || echo no)"
	cp "$work/initramfs.img" "$modules/$kver/initramfs-tilewin.img"

	if [[ $m == uki ]]; then
		local e
		e=$(esp) || die "The EFI system partition was not found"
		mkdir -p "$e/EFI/Linux"
		fits "$work/kernel.efi" "$e"
		local dest=$e/EFI/Linux/tilewin-$kver.efi
		cp "$work/kernel.efi" "$dest.new" || { rm -f "$dest.new"; die "could not write to $e"; }
		placed+=("$dest.new")
		sync
		mv "$dest.new" "$dest"
		placed+=("$dest")
		sync
		echo "image=$dest" >> "$modules/$kver/$marker"
	else
		local b=$root/boot
		fits "$work/initramfs.img" "$b"
		cp "$src/vmlinuz" "$b/vmlinuz-$kver" && placed+=("$b/vmlinuz-$kver")
		cp "$work/initramfs.img" "$b/initramfs-$kver.img" && placed+=("$b/initramfs-$kver.img")
		echo "image=$b/vmlinuz-$kver" >> "$modules/$kver/$marker"
		echo "initramfs=$b/initramfs-$kver.img" >> "$modules/$kver/$marker"
		grub_update
	fi
	placed=()
	note "$kver is on the computer"
}

# ---------- the firmware's boot entries ----------

efi_entry() { # kver: its Boot number, if it has one
	efibootmgr 2>/dev/null | sed -n "s/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\} tileWin $1\([[:space:]].*\)\{0,1\}$/\1/p" |
		head -n 1
}

boot_order() {
	efibootmgr 2>/dev/null | sed -n 's/^BootOrder: //p'
}

efi_entry_make() { # kver image
	local kver=$1 image=$2 e source disk part rel num before after
	num=$(efi_entry "$kver")
	[[ -n $num ]] && { echo "$num"; return; }
	e=$(esp) || die "The EFI system partition was not found"
	source=$(findmnt -n -o SOURCE --target "$e") || die "The disk of $e was not found"
	disk=$(lsblk -no PKNAME "$source" | head -n 1)
	part=$(cat "$root/sys/class/block/$(basename "$source")/partition" 2>/dev/null)
	[[ -n $disk && -n $part ]] || die "The disk of $e was not found"
	rel=${image#"$e"}
	rel=${rel//\//\\}
	before=$(boot_order)
	efibootmgr -C -d "/dev/$disk" -p "$part" -L "tileWin $kver" -l "$rel" >&2 ||
		die "The firmware took no boot entry"
	after=$(boot_order)
	# -C adds no entry to the boot order; should a firmware do it anyway,
	# the order goes back to what it was
	[[ $before == "$after" || -z $before ]] || efibootmgr -o "$before" >&2
	num=$(efi_entry "$kver")
	[[ -n $num ]] || die "The firmware took no boot entry"
	echo "$num"
}

efi_entry_remove() { # kver
	local num
	while num=$(efi_entry "$1") && [[ -n $num ]]; do
		# a BootNext left pointing at nothing would be skipped by most
		# firmware, but not by all
		if efibootmgr 2>/dev/null | grep -qx "BootNext: $num"; then
			efibootmgr -N >&2
		fi
		efibootmgr -b "$num" -B >&2 || break
	done
}

# ---------- taking a kernel off ----------

remove_kernel() { # kver
	local kver=$1
	valid_kver "$kver" || die "not a kernel of tileWin: $kver"
	[[ $kver != "$running" ]] || die "$kver is running now: start another kernel first"
	ours "$kver" || die "$kver is not on the computer"
	lock
	local m image initramfs
	m=$(marker_get "$kver" method)
	image=$(marker_get "$kver" image)
	initramfs=$(marker_get "$kver" initramfs)
	if efi && command -v efibootmgr >/dev/null 2>&1; then
		efi_entry_remove "$kver"
	fi
	case $image in
	*/tilewin-"$kver".efi|*/vmlinuz-"$kver") rm -f -- "$image" ;;
	esac
	case $initramfs in
	*/initramfs-"$kver".img) rm -f -- "$initramfs" ;;
	esac
	[[ $m == grub ]] && grub_update
	if command -v dkms >/dev/null 2>&1; then
		dkms status -k "$kver" 2>/dev/null | cut -d, -f1 | while read -r module; do
			[[ -n $module ]] && dkms remove "$module" -k "$kver" >/dev/null 2>&1
		done
	fi
	rm -rf -- "${modules:?}/$kver"
	sync
	note "$kver is off the computer"
}

# ---------- starting a kernel ----------

load_kernel() { # kver
	local kver=$1 ready
	valid_kver "$kver" || die "not a kernel of tileWin: $kver"
	ours "$kver" || die "$kver is not on the computer"
	ready=$(kexec_ready)
	[[ $ready == yes ]] || die "Cannot load a kernel: ${ready#no: }"
	local dir=$modules/$kver
	[[ -f $dir/vmlinuz && -f $dir/initramfs-tilewin.img ]] || die "The files of $kver are missing"
	kexec -s -l "$dir/vmlinuz" --initrd="$dir/initramfs-tilewin.img" \
			--command-line="$(cmdline)" >&2 ||
		kexec -l "$dir/vmlinuz" --initrd="$dir/initramfs-tilewin.img" \
			--command-line="$(cmdline)" >&2 ||
		die "kexec could not load $kver"
	note "Starting $kver"
	systemctl kexec
}

# The menu entry of GRUB that boots vmlinuz-KVER, as grub-reboot wants it.
grub_entry() { # kver
	local cfg
	cfg=$(grub_cfg) || return 1
	awk -v k="vmlinuz-$1" '
		function id(line,   m) {
			if (match(line, /\$menuentry_id_option +'\''[^'\'']+'\''/)) {
				m = substr(line, RSTART, RLENGTH); sub(/.*option +'\''/, "", m); sub(/'\''$/, "", m)
				return m
			}
			return ""
		}
		/^[ \t]*submenu / { sub_id = id($0) }
		/^}/ { sub_id = "" }
		/^[ \t]*menuentry / { entry = id($0) }
		/^[ \t]*linux[ \t]/ && index($0, k) && entry != "" {
			print (sub_id != "" ? sub_id ">" : "") entry; exit
		}' "$cfg"
}

boot_kernel() { # kver
	local kver=$1 how image
	valid_kver "$kver" || die "not a kernel of tileWin: $kver"
	ours "$kver" || die "$kver is not on the computer"
	how=$(marker_get "$kver" boot)
	image=$(marker_get "$kver" image)
	case $how in
	oneshot)
		bootctl set-oneshot "tilewin-$kver.efi" >&2 || die "systemd-boot took no one-shot entry"
		;;
	bootnext)
		local num
		num=$(efi_entry_make "$kver" "$image") || exit 1
		efibootmgr -n "$num" >&2 || die "The firmware took no BootNext"
		;;
	grub-reboot)
		local entry def
		def=$(sed -n 's/^GRUB_DEFAULT=["'\'']\{0,1\}\([^"'\'']*\).*/\1/p' "$root/etc/default/grub" 2>/dev/null)
		[[ $def == saved ]] || die "GRUB starts a kernel once only with GRUB_DEFAULT=saved in /etc/default/grub; choose $kver in the boot menu instead"
		entry=$(grub_entry "$kver")
		[[ -n $entry ]] || die "GRUB has no entry for $kver"
		grub-reboot "$entry" >&2 || die "grub-reboot failed"
		;;
	*) die "It is not known how to start $kver" ;;
	esac
	note "Restarting into $kver"
	systemctl reboot
}

# ---------- livepatches ----------

valid_patch_name() { [[ $1 =~ ^[a-z0-9_]{1,48}$ ]]; }

livepatch_apply() { # kver name store
	local kver=$1 name=$2 store=$3
	valid_kver "$kver" || die "not a kernel of tileWin: $kver"
	valid_patch_name "$name" || die "not a livepatch: $name"
	[[ $kver == "$running" ]] || die "A livepatch only goes into the kernel it was made for: $kver is not running"
	[[ -d $livepatch_sys ]] || die "The running kernel takes no livepatches"
	local src=$store/$kver/livepatches/$name.ko owner
	[[ -f $src ]] || die "The livepatch $name is not built"
	owned "$src" || die "$src belongs to someone else"
	local module=livepatch_$name
	[[ -d $livepatch_sys/$module ]] && die "$name is applied already"
	# a copy of root's own, so the file cannot change between check and load
	mkdir -p "$root/run/tilewin-kernel"
	local copy=$root/run/tilewin-kernel/$module.ko
	cp "$src" "$copy"
	insmod "$copy" >&2 || { rm -f "$copy"; die "The kernel did not take the livepatch $name"; }
	rm -f "$copy"
	superseded "$name"
	note "$name is applied"
}

# The fixes of kernel.org come as one module for each release, each with all
# the fixes of the ones before: a newer one takes the place of the older.
superseded() { # name now applied
	[[ $1 == security_* ]] || return 0
	local d old
	for d in "$livepatch_sys"/livepatch_security_*; do
		[[ -d $d ]] || continue
		old=${d##*/livepatch_}
		[[ $old != "$1" ]] && livepatch_undo "$old" > /dev/null
	done
	return 0
}

livepatch_start() { # kver name store on|off
	local kver=$1 name=$2 store=$3 how=$4
	valid_kver "$kver" || die "not a kernel of tileWin: $kver"
	valid_patch_name "$name" || die "not a livepatch: $name"
	ours "$kver" || die "$kver is not on the computer: add it to the boot menu first"
	local dir=$modules/$kver/livepatch
	case $how in
	on)
		local src=$store/$kver/livepatches/$name.ko owner
		[[ -f $src ]] || die "The livepatch $name is not built"
		owned "$src" || die "$src belongs to someone else"
		mkdir -p "$dir"
		cp "$src" "$dir/livepatch_$name.ko.new"
		mv "$dir/livepatch_$name.ko.new" "$dir/livepatch_$name.ko"
		if [[ $name == security_* ]]; then
			local f
			for f in "$dir"/livepatch_security_*.ko; do
				[[ $f == "$dir/livepatch_$name.ko" ]] || rm -f -- "$f"
			done
		fi
		systemctl enable tilewin-kernel-livepatch.service >&2 2>/dev/null ||
			note "tilewin-kernel-livepatch.service could not be enabled: install tileWin again"
		note "$name is applied at every start of $kver"
		;;
	off)
		rm -f -- "$dir/livepatch_$name.ko"
		rmdir "$dir" 2>/dev/null
		note "$name is no more applied at start"
		;;
	*) die "on or off" ;;
	esac
}

# At start: the livepatches set for the running kernel, if it is ours.
livepatch_boot() {
	ours "$running" || return 0
	local dir=$modules/$running/livepatch f name
	[[ -d $dir && -d $livepatch_sys ]] || return 0
	for f in "$dir"/livepatch_*.ko; do
		[[ -f $f ]] || continue
		name=${f##*/livepatch_}
		name=${name%.ko}
		valid_patch_name "$name" || continue
		[[ -d $livepatch_sys/livepatch_$name ]] && continue
		if insmod "$f" >&2; then
			note "$name is applied"
		else
			echo "The kernel did not take the livepatch $name" >&2
		fi
	done
}

livepatch_undo() { # name
	local name=$1
	valid_patch_name "$name" || die "not a livepatch: $name"
	local module=livepatch_$name d=$livepatch_sys/livepatch_$name
	[[ -d $d ]] || die "$name is not applied"
	echo 0 > "$d/enabled" || die "The kernel did not let go of $name"
	# the change goes through task by task; the module stays until it is done
	local n
	for n in $(seq 120); do
		[[ -d $d && $(cat "$d/transition" 2>/dev/null) == 1 ]] || break
		sleep 0.5
	done
	[[ -d $d && $(cat "$d/transition" 2>/dev/null) == 1 ]] &&
		die "$name is still being taken out: some tasks are busy; try again in a minute"
	rmmod "$module" 2>/dev/null || true
	note "$name is undone"
}

# ---------- the scheduler at start ----------

scheduler_default() { # scheduler mode
	local sched=$1 mode=$2
	if [[ $sched == none ]]; then
		if [[ -f $scx_conf ]] && grep -q '^# written by the Kernel page of the tileWin settings' "$scx_conf"; then
			rm -f "$scx_conf"
		fi
		systemctl disable scx_loader.service >&2 2>/dev/null || true
		note "No sched_ext scheduler at start"
		return
	fi
	[[ $sched =~ ^scx_[a-z0-9_]{1,32}$ ]] || die "not a sched_ext scheduler: $sched"
	case $mode in Auto|Gaming|PowerSave|LowLatency|Server) ;; *) die "not a mode: $mode" ;; esac
	command -v "$sched" >/dev/null 2>&1 || die "$sched is not installed"
	# a config of the administrator's own stays as it is
	if [[ -f $scx_conf ]] && ! grep -q '^# written by the Kernel page of the tileWin settings' "$scx_conf"; then
		die "$scx_conf was written by hand: set default_sched there"
	fi
	if [[ -f $root/etc/scx_loader.toml ]]; then
		die "$root/etc/scx_loader.toml was written by hand: set default_sched there"
	fi
	mkdir -p "$(dirname "$scx_conf")"
	{
		echo '# written by the Kernel page of the tileWin settings'
		echo "default_sched = \"$sched\""
		echo "default_mode = \"$mode\""
	} > "$scx_conf.new"
	mv "$scx_conf.new" "$scx_conf"
	systemctl enable scx_loader.service >&2 || die "scx_loader could not be set to start"
	note "$sched starts with the computer"
}

# ---------- the automatic updates ----------
#
# Kept up to date without restarts, as far as Linux can be:
#  - at the time set on the Kernel page (or at "Update now"), and only then:
#  - the fixes kernel.org has for the running kernel are made into a livepatch
#    and applied at once (and at every start of that kernel), checked: a
#    kernel that complains in its log right after takes it out again;
#  - each new release of the series is built in the background, put on the
#    computer and set to start once at the next restart, which the user makes
#    whenever they like; when the series ends, the newest series is built;
#  - the start of a new kernel is checked: one that did not come up twice is
#    not started again, and the one before it is;
#  - old kernels of the automatic updates are taken off and deleted.
# The boot loader's default stays the distribution's kernel: the kernel of the
# updates is set to start once, again at every start that reached it, so a
# kernel that does not start leaves the computer with the distribution's.
#
# The builds run as the system user tilewin-kernel (tilewin-kernel-auto-build@
# fixes and @kernel.service), never as the user, so nothing a program of the
# user could write to is ever loaded into the kernel without the password.
# /etc/tilewin/kernel-auto.conf says what to build and for whom; the state for
# the Kernel page and the kernel widget is /var/lib/tilewin/kernel-auto/status
# (key=value), what was done is its log, and the builds write how far they are
# to build/fixes and build/kernel there.

auto_conf=$root/etc/tilewin/kernel-auto.conf
auto_state=$root/var/lib/tilewin/kernel-auto
auto_user=tilewin-kernel
auto_dropin=$root/etc/systemd/system/tilewin-kernel-auto-build@.service.d
tool=${TILEWIN_KERNEL_TOOL:-@bindir@/tilewin-kernel}

auto_get() { sed -n "s/^$1=//p" "$auto_conf" 2>/dev/null | tail -n 1; }
auto_on() { [[ $(auto_get enabled) == yes ]]; }
auto_kernels() { echo "$(auto_get store)/data/tileWin/kernels"; }

# One key of the status, the others kept.
st() { # key value
	mkdir -p "$auto_state"
	local f=$auto_state/status
	{
		grep -v "^$1=" "$f" 2>/dev/null
		printf '%s=%s\n' "$1" "$2"
	} > "$f.new" && mv -f "$f.new" "$f"
	chmod 644 "$f"
}

# A line of what was done, newest last, the last 50 kept.
auto_log() { # text
	mkdir -p "$auto_state"
	printf '%s\t%s\n' "$(date +%s)" "$*" >> "$auto_state/log"
	tail -n 50 "$auto_state/log" > "$auto_state/log.new" && mv -f "$auto_state/log.new" "$auto_state/log"
	chmod 644 "$auto_state/log"
}

# A notification on the desktop of the user the updates are for.
notify() { # title text [low|normal|critical]
	if [[ -n ${TILEWIN_KERNEL_NOTIFY:-} ]]; then
		printf '%s\t%s\t%s\n' "${3:-normal}" "$1" "$2" >> "$TILEWIN_KERNEL_NOTIFY"
		return 0
	fi
	local user uid
	user=$(auto_get user)
	uid=$(id -u "$user" 2>/dev/null) || return 0
	[[ -S /run/user/$uid/bus ]] || return 0
	runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
		notify-send -a "Kernel updates" -i software-update-available -u "${3:-normal}" \
		"$1" "$2" >/dev/null 2>&1 || true
}

boot_id() { cat "$root/proc/sys/kernel/random/boot_id" 2>/dev/null || echo none; }

# On mains power, or a computer without a battery.
on_mains() {
	local d have_battery=no
	for d in "$root"/sys/class/power_supply/*/; do
		case $(cat "$d/type" 2>/dev/null) in
		Mains) [[ $(cat "$d/online" 2>/dev/null) == 1 ]] && return 0 ;;
		Battery) have_battery=yes ;;
		esac
	done
	[[ $have_battery == no ]]
}

# Its release, 7.3 being 7.3.0.
auto_release() { # kver
	local v
	v=$(sed -n 's/^version=//p' "$(auto_kernels)/$1/info" 2>/dev/null | tail -n 1)
	[[ -z $v || $v == *.*.* ]] || v=$v.0
	echo "$v"
}

# The kernels of the automatic updates: KVER<tab>RELEASE<tab>STATE, oldest first.
auto_list() {
	local d k store
	store=$(auto_kernels)
	for d in "$store"/*/; do
		[[ -d $d ]] || continue
		k=$(basename "$d")
		valid_kver "$k" || continue
		grep -qx 'auto=yes' "$d/info" 2>/dev/null || continue
		printf '%s\t%s\t%s\n' "$k" "$(auto_release "$k")" "$(cat "$d/state" 2>/dev/null)"
	done | sort -t$'\t' -k2,2V
}

listed() { [[ -f $auto_state/$1 ]] && grep -qxF -- "$2" "$auto_state/$1"; }

# A build of the system user, waited for; for the tests, without systemd.
auto_unit() { # fixes|kernel
	if [[ -n ${TILEWIN_KERNEL_AUTO_INLINE:-} ]]; then
		TILEWIN_KERNEL_STATUS=$auto_state/build/$1 TILEWIN_KERNEL_AUTO_CONF=$auto_conf \
			XDG_DATA_HOME=$(auto_get store)/data XDG_CACHE_HOME=$(auto_get store)/cache \
			TILEWIN_KERNEL_RUNNING=$running bash "$tool" auto-build "$1"
	else
		systemctl start "tilewin-kernel-auto-build@$1.service"
	fi
}

# The kernel's log, for what went wrong right after a livepatch.
kernel_log() {
	if [[ -n ${TILEWIN_KERNEL_DMESG:-} ]]; then
		cat -- "$TILEWIN_KERNEL_DMESG" 2>/dev/null
	else
		dmesg 2>/dev/null
	fi
}

# The newest fixes made for the running kernel, applied, checked and set for
# every start of it.
auto_fixes() {
	local store kver=$running lp name best="" n
	store=$(auto_kernels)
	lp=$store/$kver/livepatches
	[[ -d $lp ]] || return 0
	for n in "$lp"/security_*.state; do
		[[ -f $n && $(cat "$n") == built && -f ${n%.state}.ko ]] || continue
		name=$(basename "$n" .state)
		listed bad "$name" && continue
		best=$(printf '%s\n%s\n' "$best" "$name" | sort -V | tail -n 1)
	done
	[[ -n $best ]] || return 0
	name=$best
	local to=${name#security_} left
	to=${to//_/.}
	left=$(grep -c . "$lp/$name.left" 2>/dev/null)
	if [[ -d $livepatch_sys/livepatch_$name ]]; then
		st fixes "$to"
		st fixes_left "${left:-0}"
		return 0
	fi
	st state applying
	st message "Applying the fixes of Linux $to"
	local before out
	before=$(kernel_log | wc -l)
	if ! out=$( (livepatch_apply "$kver" "$name" "$store") 2>&1); then
		echo "$name" >> "$auto_state/bad"
		auto_log "The kernel did not take the fixes of Linux $to: $out"
		notify "Kernel fixes not applied" "The kernel did not take the fixes of Linux $to. Restart into the newest kernel to get them." critical
		return 1
	fi
	# the change goes through task by task; then a while to see that all is well
	local i
	for i in $(seq 120); do
		[[ $(cat "$livepatch_sys/livepatch_$name/transition" 2>/dev/null) == 1 ]] || break
		sleep 0.5
	done
	sleep "${TILEWIN_KERNEL_SETTLE:-20}"
	local trouble
	trouble=$(kernel_log | tail -n +"$((before + 1))" |
		grep -E -m1 'Oops|BUG:|general protection|kernel panic|Call Trace|WARNING: CPU|livepatch: .*(fail|error)')
	if [[ -n $trouble ]]; then
		(livepatch_undo "$name") >/dev/null 2>&1
		echo "$name" >> "$auto_state/bad"
		auto_log "The fixes of Linux $to were taken out again: the kernel said \"${trouble:0:160}\""
		notify "Kernel fixes taken out again" "Right after the fixes of Linux $to the kernel reported a problem, so they were undone. Restart into the newest kernel to get them." critical
		return 1
	fi
	(livepatch_start "$kver" "$name" "$store" on) >/dev/null 2>&1
	st fixes "$to"
	st fixes_left "${left:-0}"
	st fixes_applied "$(date +%s)"
	local more="" also=""
	if [[ ${left:-0} -gt 0 ]]; then
		more=" $left changed files cannot be patched live: they come with the next kernel."
		also="; $left files need a restart"
	fi
	auto_log "Applied the fixes of Linux $to live$also"
	notify "Kernel fixed without a restart" "The security fixes of Linux $to are in the running kernel now.$more"
}

# The newest kernel built and not on the computer yet goes on.
auto_install() {
	local k rel state newest="" store out
	store=$(auto_kernels)
	while IFS=$'\t' read -r k rel state; do
		[[ $state == built ]] || continue
		listed failed "$k" && continue
		newest=$k
	done < <(auto_list)
	[[ -n $newest ]] || return 0
	ours "$newest" && return 0
	st state installing
	st message "Putting Linux $(auto_release "$newest") on the computer"
	if out=$( (install_kernel "$newest" "$store") 2>&1); then
		auto_log "Linux $(auto_release "$newest") is on the computer ($newest)"
		return 0
	fi
	echo "$newest" >> "$auto_state/failed"
	auto_log "Linux $(auto_release "$newest") could not be put on the computer: $(tail -n 1 <<<"$out")"
	notify "New kernel not ready" "Linux $(auto_release "$newest") could not be put on the computer: $(tail -n 1 <<<"$out")" critical
	return 1
}

# The kernel to start next: the newest of the updates on the computer that
# did not fail to start.
auto_target() {
	local k rel state target=""
	while IFS=$'\t' read -r k rel state; do
		[[ $state == built ]] && ours "$k" && ! listed failed "$k" && target=$k
	done < <(auto_list)
	echo "$target"
}

# Sets a kernel to start once at the next restart; prints why not.
arm_once() { # kver
	local target=$1 how image
	how=$(marker_get "$target" boot)
	image=$(marker_get "$target" image)
	case $how in
	oneshot)
		bootctl set-oneshot "tilewin-$target.efi" 2>&1 ;;
	bootnext)
		local num
		local err
		err=$(mktemp)
		num=$(efi_entry_make "$target" "$image" 2>"$err")
		[[ $num =~ ^[0-9A-Fa-f]{4}$ ]] || { tail -n 1 "$err"; rm -f "$err"; return 1; }
		rm -f "$err"
		efibootmgr 2>/dev/null | grep -qx "BootNext: $num" && return 0
		efibootmgr -n "$num" 2>&1 >/dev/null ;;
	grub-reboot)
		local def entry
		def=$(sed -n 's/^GRUB_DEFAULT=["'\'']\{0,1\}\([^"'\'']*\).*/\1/p' "$root/etc/default/grub" 2>/dev/null)
		[[ $def == saved ]] || { echo "GRUB starts a kernel once only with GRUB_DEFAULT=saved in /etc/default/grub"; return 1; }
		entry=$(grub_entry "$target")
		[[ -n $entry ]] || { echo "GRUB has no entry for $target"; return 1; }
		grub-reboot "$entry" 2>&1 ;;
	*) echo "it is not known how to start $target"; return 1 ;;
	esac
}

# The kernel to start next set for the next restart; for the same kernel the
# count of starts it missed is kept.
auto_arm() {
	local target misses=0 k="" b="" m="" out
	target=$(auto_target)
	if [[ -z $target ]]; then
		auto_disarm
		st next ""
		return 0
	fi
	{ read -r k b m < "$auto_state/armed"; } 2>/dev/null
	[[ $k == "$target" && $m =~ ^[0-9]+$ ]] && misses=$m
	if ! out=$(arm_once "$target"); then
		st arm_error "${out:0:200}"
		auto_log "Linux $(auto_release "$target") could not be set for the next start: ${out:0:160}"
		return 1
	fi
	st arm_error ""
	echo "$target $(boot_id) $misses" > "$auto_state/armed"
	if [[ $target != "$running" ]]; then
		if [[ $(sed -n 's/^next=//p' "$auto_state/status" 2>/dev/null) != "$target" ]]; then
			auto_log "Linux $(auto_release "$target") starts at the next restart"
			notify "New kernel ready" "Linux $(auto_release "$target") starts the next time you restart. Until then the running kernel gets its fixes live." low
		fi
		st next "$target"
	else
		st next ""
	fi
}

auto_disarm() {
	local k="" b="" m="" num
	{ read -r k b m < "$auto_state/armed"; } 2>/dev/null || return 0
	if [[ -n $k ]] && ours "$k"; then
		case $(marker_get "$k" boot) in
		oneshot) bootctl set-oneshot "" >/dev/null 2>&1 ;;
		bootnext)
			num=$(efi_entry "$k")
			[[ -n $num ]] && efibootmgr 2>/dev/null | grep -qx "BootNext: $num" && efibootmgr -N >/dev/null 2>&1 ;;
		grub-reboot) grub-editenv - unset next_entry >/dev/null 2>&1 ;;
		esac
	fi
	rm -f "$auto_state/armed"
}

# How the start went that the last arming was for: the kernel came up, or the
# computer started another one; twice another, and that kernel is not started
# again. Once a start.
auto_verdict() {
	local k="" b="" m="" now
	{ read -r k b m < "$auto_state/armed"; } 2>/dev/null || return 0
	now=$(boot_id)
	[[ -n $k && $b != "$now" ]] || return 0
	[[ $m =~ ^[0-9]+$ ]] || m=0
	if [[ $k == "$running" ]]; then
		local before
		before=$(cat "$auto_state/good" 2>/dev/null)
		echo "$k" > "$auto_state/good"
		echo "$k $now 0" > "$auto_state/armed"
		[[ $before == "$k" ]] || auto_log "Linux $(auto_release "$k") started well ($k)"
		return 0
	fi
	m=$((m + 1))
	if [[ $m -ge 2 ]]; then
		echo "$k" >> "$auto_state/failed"
		rm -f "$auto_state/armed"
		auto_log "Linux $(auto_release "$k") did not come up twice: it is not started again"
		notify "New kernel did not start" "Linux $(auto_release "$k") did not come up twice, so the computer stays with $running. The next release is tried when it is out." critical
	else
		echo "$k $now $m" > "$auto_state/armed"
		auto_log "The computer started $running instead of Linux $(auto_release "$k")"
	fi
}

# The old kernels of the updates go: those older than the one to start next
# (or than the running one, when none is set), and those that did not start;
# never the running one, the one to start next or the last that started well.
# Builds that failed stay until auto-build tries again.
auto_cleanup() {
	local keep target good k rel state ref tree
	target=$(auto_target)
	good=$(cat "$auto_state/good" 2>/dev/null)
	keep=" $running $target $good "
	ref=$(auto_release "${target:-$running}")
	while IFS=$'\t' read -r k rel state; do
		[[ $keep == *" $k "* || $state != built ]] && continue
		if ! listed failed "$k"; then
			[[ -n $ref ]] || continue
			# only what is older than the reference, or as old
			[[ $(printf '%s\n%s\n' "$ref" "$rel" | sort -V | tail -n 1) == "$ref" ]] || continue
		fi
		if ours "$k"; then
			(remove_kernel "$k") >/dev/null 2>&1 || continue
		fi
		tree=$(sed -n 's/^tree=//p' "$(auto_kernels)/$k/info" 2>/dev/null)
		[[ -n $tree && $tree == "$(auto_get store)"/* ]] && rm -rf -- "$tree"
		rm -rf -- "${k:+$(auto_kernels)/$k}"
		auto_log "Linux $rel ($k) was taken off: a newer one is there"
	done < <(auto_list)
}

auto_run() {
	auto_on || { st state off; return 0; }
	mkdir -p "$root/run"
	exec 8> "$root/run/tilewin-kernel-auto.lock"
	flock -n 8 || { echo "The automatic updates are running already"; return 0; }
	auto_uid=$(id -u "$auto_user" 2>/dev/null)
	if [[ -z $auto_uid ]]; then
		[[ -n ${TILEWIN_KERNEL_AUTO_INLINE:-} ]] || die "There is no user $auto_user: switch the automatic updates on again"
		auto_uid=$(id -u)
	fi
	st running "$running"
	st running_auto "$([[ -d $(auto_kernels)/$running ]] && echo yes || echo no)"
	st error ""
	# "Update now": what failed or was stopped before is tried again at once
	if [[ -n ${TILEWIN_KERNEL_AUTO_MANUAL:-} ]]; then
		local k rel state
		while IFS=$'\t' read -r k rel state; do
			case $state in
			failed|cancelled)
				rm -rf -- "$(auto_kernels)/$k" "$(auto_get store)/cache/tileWin/kernel/build/$k" ;;
			esac
		done < <(auto_list)
	fi
	auto_verdict
	if [[ -d $(auto_kernels)/$running ]]; then
		st state fixes
		st message "Looking for fixes of kernel.org"
		auto_unit fixes ||
			st error "The fixes could not be made: $(sed -n 's/^text=//p' "$auto_state/build/fixes" 2>/dev/null)"
		auto_fixes
	else
		st fixes ""
		st fixes_left ""
	fi
	if on_mains || [[ $(auto_get battery) == yes ]]; then
		st power ""
		st state building
		st message "Looking for a new release"
		auto_unit kernel ||
			st error "The new kernel could not be built: $(sed -n 's/^text=//p' "$auto_state/build/kernel" 2>/dev/null)"
	else
		st power battery
	fi
	auto_install
	auto_arm
	auto_cleanup
	st checked "$(date +%s)"
	st state idle
	st message ""
}

# At start: how the start went, and the next one armed again.
auto_boot() {
	auto_on || return 0
	auto_uid=$(id -u "$auto_user" 2>/dev/null)
	st running "$running"
	st running_auto "$([[ -d $(auto_kernels)/$running ]] && echo yes || echo no)"
	auto_verdict
	auto_arm
}

# Where the store goes: below /var/lib, or /home when that is another file
# system with more room (a kernel tree with its objects takes 10 to 35 GB).
auto_store_place() {
	local best=$root/var/lib/tilewin-kernel best_free=0 c dir free
	for c in "$root/var/lib/tilewin-kernel" "$root/home/.tilewin-kernel"; do
		dir=$(dirname "$c")
		[[ -d $dir ]] || continue
		free=$(df -Pk "$dir" 2>/dev/null | awk 'NR == 2 { print $4 }')
		[[ $free =~ ^[0-9]+$ ]] || continue
		if [[ $free -gt $best_free ]]; then
			best=$c
			best_free=$free
		fi
	done
	echo "$best"
}

auto_enable() { # user profile native series [key=value...]
	local user=$1 profile=$2 native=$3 series=$4
	shift 4
	local extra=("$@") pair
	for pair in "${extra[@]}"; do
		case $pair in
		battery=yes|battery=no|catchup=yes|catchup=no) ;;
		when=daily|when=mon|when=tue|when=wed|when=thu|when=fri|when=sat|when=sun) ;;
		time=[0-2][0-9]:[0-5][0-9]) ;;
		*) die "not an option: $pair" ;;
		esac
	done
	[[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && id -u "$user" >/dev/null 2>&1 || die "There is no user $user"
	[[ -n ${PKEXEC_UID:-} && $(id -u "$user") != "$PKEXEC_UID" ]] &&
		die "The updates can only be switched on for yourself"
	case $profile in running|device|portable|full) ;; *) die "unknown profile $profile" ;; esac
	case $native in on|off) ;; *) die "for this processor is on or off" ;; esac
	case $series in end|new) ;; *) die "a new series: end or new" ;; esac
	if [[ -z $root ]] && ! id -u "$auto_user" >/dev/null 2>&1; then
		systemd-sysusers tilewin-kernel.conf >&2 2>/dev/null
		id -u "$auto_user" >/dev/null 2>&1 ||
			useradd --system --no-create-home --home-dir /var/lib/tilewin-kernel \
				--shell /usr/bin/nologin --comment "tileWin kernel builds" "$auto_user" >&2 ||
			die "The user $auto_user could not be made"
	fi
	local store owner=$auto_user
	[[ -n $root ]] && owner=$(id -un)
	store=$(auto_get store)
	[[ -n $store ]] || store=$(auto_store_place)
	mkdir -p "$store"/{data,cache,gnupg,ccache} "$auto_state/build"
	chown -R "$owner:$(id -gn "$owner")" "$store" "$auto_state/build"
	chmod 755 "$store" "$store/data" "$auto_state" "$auto_state/build"
	chmod 700 "$store/gnupg"
	mkdir -p "$auto_dropin"
	{
		echo "# written by tilewin-kernel-root auto-enable: where the builds keep their files"
		echo "[Service]"
		echo "ReadWritePaths=$store"
		echo "Environment=XDG_DATA_HOME=$store/data XDG_CACHE_HOME=$store/cache GNUPGHOME=$store/gnupg"
		echo "Environment=CCACHE_DIR=$store/ccache CCACHE_MAXSIZE=25G HOME=$store"
	} > "$auto_dropin/store.conf"
	local battery when at catchup
	battery=$(auto_get battery)
	when=$(auto_get when)
	at=$(auto_get time)
	catchup=$(auto_get catchup)
	mkdir -p "$(dirname "$auto_conf")"
	{
		echo "# tileWin's automatic kernel updates (the Kernel page of the settings)"
		echo "enabled=yes"
		echo "user=$user"
		echo "store=$store"
		echo "profile=$profile"
		echo "native=$native"
		echo "series=$series"
		echo "battery=${battery:-no}"
		echo "when=${when:-daily}"
		echo "time=${at:-03:00}"
		echo "catchup=${catchup:-yes}"
	} > "$auto_conf.new"
	mv "$auto_conf.new" "$auto_conf"
	chmod 644 "$auto_conf"
	for pair in "${extra[@]}"; do
		sed -i "/^${pair%%=*}=/d" "$auto_conf"
		echo "$pair" >> "$auto_conf"
	done
	# what the builds need, with ccache for quick builds of the next release and
	# patchutils for the live fixes
	local missing=() line pkg
	while read -r line; do
		[[ -n $line ]] || continue
		case $line in
		*:ccache:optional|*:patchutils:optional) ;;
		*:optional) continue ;;
		esac
		pkg=${line#*:}
		missing+=("${pkg%%:*}")
	done < <(bash "$tool" check zstd 2>/dev/null)
	if [[ ${#missing[@]} -gt 0 ]]; then
		note "Installing ${missing[*]}"
		tools "${missing[@]}" >&2 || die "The programs a build needs could not be installed: ${missing[*]}"
	fi
	st state idle
	st error ""
	auto_log "The automatic updates were switched on"
	# nothing is downloaded or built now: at the time set, or at "Update now"
	schedule_write
	systemctl daemon-reload >&2
	systemctl enable tilewin-kernel-auto.timer tilewin-kernel-auto-boot.service >&2 ||
		die "The units of the automatic updates are missing: install tileWin again"
	systemctl restart tilewin-kernel-auto.timer >&2
	note "The automatic updates are on: they run $(schedule_words)"
}

auto_disable() {
	[[ -f $auto_conf ]] || { note "The automatic updates are off"; return 0; }
	sed -i 's/^enabled=.*/enabled=no/' "$auto_conf"
	systemctl disable --now tilewin-kernel-auto.timer tilewin-kernel-auto-boot.service >&2 2>/dev/null
	systemctl stop tilewin-kernel-auto.service tilewin-kernel-auto-now.service \
		'tilewin-kernel-auto-build@*.service' >&2 2>/dev/null
	auto_disarm
	st state off
	st next ""
	auto_log "The automatic updates were switched off"
	note "The automatic updates are off; the kernels they made stay until you take them off"
}

# When the timer runs: its drop-in from the config (when, time, catchup).
schedule_write() {
	local when at catchup day=""
	when=$(auto_get when)
	at=$(auto_get time)
	catchup=$(auto_get catchup)
	[[ $at =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || at=03:00
	case $when in
	mon|tue|wed|thu|fri|sat|sun) day="${when^} " ;;
	esac
	mkdir -p "$root/etc/systemd/system/tilewin-kernel-auto.timer.d"
	{
		echo "# written by tilewin-kernel-root auto-schedule (the Kernel page)"
		echo "[Timer]"
		echo "OnCalendar="
		echo "OnCalendar=${day}*-*-* $at:00"
		echo "Persistent=$([[ $catchup == no ]] && echo false || echo true)"
	} > "$root/etc/systemd/system/tilewin-kernel-auto.timer.d/schedule.conf"
}

schedule_words() {
	local when at
	when=$(auto_get when)
	at=$(auto_get time)
	case $when in
	mon) echo "every Monday at ${at:-03:00}" ;;
	tue) echo "every Tuesday at ${at:-03:00}" ;;
	wed) echo "every Wednesday at ${at:-03:00}" ;;
	thu) echo "every Thursday at ${at:-03:00}" ;;
	fri) echo "every Friday at ${at:-03:00}" ;;
	sat) echo "every Saturday at ${at:-03:00}" ;;
	sun) echo "every Sunday at ${at:-03:00}" ;;
	*) echo "every day at ${at:-03:00}" ;;
	esac
}

# When the updates run: daily or a day of the week, HH:MM, and whether a time
# the computer was off at is made up for at the next start.
auto_schedule() { # when time catchup
	[[ -f $auto_conf ]] || die "The automatic updates were never switched on"
	case $1 in daily|mon|tue|wed|thu|fri|sat|sun) ;; *) die "not a day: $1" ;; esac
	[[ $2 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "not a time: $2"
	case $3 in yes|no) ;; *) die "catch up yes or no" ;; esac
	sed -i '/^when=/d; /^time=/d; /^catchup=/d' "$auto_conf"
	printf 'when=%s\ntime=%s\ncatchup=%s\n' "$1" "$2" "$3" >> "$auto_conf"
	schedule_write
	systemctl daemon-reload >&2
	auto_on && systemctl restart tilewin-kernel-auto.timer >&2
	note "The updates run $(schedule_words)"
}

# Several options at once, KEY=VALUE: what auto-set and auto-schedule take
# (when, time, catchup too), checked all before any is written; one password
# for all the changes of the Kernel page.
auto_config() { # key=value...
	[[ -f $auto_conf ]] || die "The automatic updates were never switched on"
	local pair key value timer=no
	for pair; do
		key=${pair%%=*}
		value=${pair#*=}
		case $key=$value in
		battery=yes|battery=no|series=end|series=new|native=on|native=off|catchup=yes|catchup=no) ;;
		profile=running|profile=device|profile=portable|profile=full) ;;
		when=daily|when=mon|when=tue|when=wed|when=thu|when=fri|when=sat|when=sun) ;;
		time=*) [[ $value =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "not a time: $value" ;;
		*) die "not an option: $pair" ;;
		esac
	done
	for pair; do
		key=${pair%%=*}
		value=${pair#*=}
		sed -i "/^$key=/d" "$auto_conf"
		echo "$key=$value" >> "$auto_conf"
		case $key in when|time|catchup) timer=yes ;; esac
	done
	if [[ $timer == yes ]]; then
		schedule_write
		systemctl daemon-reload >&2
		auto_on && systemctl restart tilewin-kernel-auto.timer >&2
	fi
	note "Saved: the updates run $(schedule_words)"
}

# An option of the updates: battery yes|no, series end|new, native on|off,
# profile; they count from the next build on.
auto_set() { # key value
	[[ -f $auto_conf ]] || die "The automatic updates were never switched on"
	case $1=$2 in
	battery=yes|battery=no|series=end|series=new|native=on|native=off) ;;
	profile=running|profile=device|profile=portable|profile=full) ;;
	*) die "not an option: $1=$2" ;;
	esac
	sed -i "/^$1=/d" "$auto_conf"
	echo "$1=$2" >> "$auto_conf"
	note "$1 is $2"
}

# The packages of Debian for the names of Arch, which tilewin-kernel check uses;
# nothing for what Debian does not have.
debian_packages() { # arch name
	case $1 in
	xz) echo xz-utils ;;
	python) echo python3 ;;
	pahole) echo dwarves ;;
	libelf) echo libelf-dev ;;
	openssl) echo openssl libssl-dev ;;
	base-devel) echo build-essential ;;
	rust) echo rustc ;;
	rust-bindgen) echo bindgen ;;
	scx-scheds|scx-tools) ;;
	*) echo "$1" ;;
	esac
}

tools() {
	local p
	for p in "$@"; do
		[[ $allowed_tools == *" $p "* ]] || die "not a build tool: $p"
	done
	if command -v pacman >/dev/null 2>&1; then
		pacman -S --needed --noconfirm "$@"
	elif command -v apt-get >/dev/null 2>&1; then
		local debian=() names
		for p in "$@"; do
			names=$(debian_packages "$p")
			[[ -n $names ]] || die "Debian has no package of $p: install it from its own source"
			read -ra names <<<"$names"
			debian+=("${names[@]}")
		done
		export DEBIAN_FRONTEND=noninteractive
		# the lists of the packages may be too old for what is to be installed
		apt-get install -y "${debian[@]}" >&2 ||
			{ apt-get update >&2 && apt-get install -y "${debian[@]}" >&2; } ||
			die "apt-get could not install ${debian[*]}"
	else
		die "Install these with the package manager: $*"
	fi
}

case ${1:-} in
info) info ;;
install) [[ $# -eq 3 ]] || die "usage: tilewin-kernel-root install KVER STORE"; install_kernel "$2" "$3" ;;
remove) [[ $# -eq 2 ]] || die "usage: tilewin-kernel-root remove KVER"; remove_kernel "$2" ;;
load|boot)
	[[ $# -eq 2 || $# -eq 3 ]] || die "usage: tilewin-kernel-root $1 KVER [STORE]"
	if [[ $# -eq 3 ]] && valid_kver "$2" && ! ours "$2"; then
		install_kernel "$2" "$3" || exit 1
		trap - EXIT
		exec 9>&-
	fi
	if [[ $1 == load ]]; then load_kernel "$2"; else boot_kernel "$2"; fi ;;
tools) shift; [[ $# -gt 0 ]] || die "usage: tilewin-kernel-root tools PACKAGE..."; tools "$@" ;;
livepatch-apply) [[ $# -eq 4 ]] || die "usage: tilewin-kernel-root livepatch-apply KVER NAME STORE"
	livepatch_apply "$2" "$3" "$4" ;;
livepatch-start) [[ $# -eq 5 ]] || die "usage: tilewin-kernel-root livepatch-start KVER NAME STORE on|off"
	livepatch_start "$2" "$3" "$4" "$5" ;;
livepatch-boot) livepatch_boot ;;
livepatch-undo) [[ $# -eq 2 ]] || die "usage: tilewin-kernel-root livepatch-undo NAME"
	livepatch_undo "$2" ;;
scheduler-default) [[ $# -eq 3 ]] || die "usage: tilewin-kernel-root scheduler-default SCHEDULER MODE"
	scheduler_default "$2" "$3" ;;
auto-enable) [[ $# -ge 5 ]] || die "usage: tilewin-kernel-root auto-enable USER PROFILE NATIVE SERIES [KEY=VALUE...]"
	shift; auto_enable "$@" ;;
auto-config) shift; [[ $# -gt 0 ]] || die "usage: tilewin-kernel-root auto-config KEY=VALUE..."
	auto_config "$@" ;;
auto-disable) auto_disable ;;
auto-set) [[ $# -eq 3 ]] || die "usage: tilewin-kernel-root auto-set KEY VALUE"; auto_set "$2" "$3" ;;
auto-schedule) [[ $# -eq 4 ]] || die "usage: tilewin-kernel-root auto-schedule daily|mon..sun HH:MM yes|no"
	auto_schedule "$2" "$3" "$4" ;;
auto-run) auto_run ;;
auto-boot) auto_boot ;;
*) die "usage: tilewin-kernel-root info|install|remove|load|boot|tools|livepatch-apply|livepatch-undo|livepatch-start|livepatch-boot|scheduler-default|auto-enable|auto-disable|auto-set|auto-config|auto-schedule|auto-run|auto-boot" ;;
esac
